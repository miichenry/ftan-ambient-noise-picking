#!/bin/bash
#SBATCH --job-name=ftan_pick
#SBATCH --partition=public-cpu,public-bigmem
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=4G
#SBATCH --time=1-00:00:00
#SBATCH --output="outslurm/%x_%J_%a.out"
#SBATCH --array=0-11

# ── Configuration ──────────────────────────────────────────────────────────────
# File list: one H5 path per line, generated by create_filelist.sh
FILELIST="/home/users/h/henrymi/ftan-ambient-noise-picking/h5_filelist.txt"
CODEDIR="/home/users/h/henrymi/ftan-ambient-noise-picking"

# Number of files to process per array task
FILES_PER_TASK=100

# ── Run ────────────────────────────────────────────────────────────────────────
cd "$CODEDIR"
mkdir -p outslurm

for k in $(seq 0 $((FILES_PER_TASK - 1))); do
    ROW=$(( ${SLURM_ARRAY_TASK_ID} * ${FILES_PER_TASK} + $k + 1 ))
    sfile=$(sed -n "${ROW}p" "$FILELIST")

    # Skip empty lines (past end of file)
    if [ -z "$sfile" ]; then
        continue
    fi

    echo "Task ${SLURM_ARRAY_TASK_ID}, file $k: $sfile"
    python3 pick_dispersion.py "$sfile"
done

echo "Array task ${SLURM_ARRAY_TASK_ID} done."
